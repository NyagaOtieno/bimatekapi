generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  clients  Client[]
  policies Policy[]
  quotes   Quote[]
}

model Underwriter {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id               Int            @id @default(autoincrement())
  name             String
  description      String
  underwriterId    Int
  underwriter      Underwriter    @relation(fields: [underwriterId], references: [id])
  underwriterName  String         @default("UNKNOWN") 
  agentcode        String

  // Premium structure
  basePremium      Float?         // Fixed premium (mainly TPO / base)
  premium_week     Float?
  premium_2weeks   Float?
  premium_month    Float?
  premium_3months  Float?
  premium_6months  Float?
  premium_annual   Float?
  minimumPremium   Float?

  // Risk definitions
  coverPeriod      CoverPeriod?   // period supported (one of enum)
  vehicleClass     VehicleClass[]
  coverage         CoverageType

  // PSV-specific (seat capacity handled via PsvPremium)
  minSeats         Int?           // optional for general info
  maxSeats         Int?

  // Goods/commercial-specific
  tonnage          Int?

  // Comprehensive-specific
  minAge           Int?           
  maxAge           Int?
  minValue         Float?
  maxValue         Float?

  ExcludedMakes    String[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  policies         Policy[]
  quotes           Quote[]
  psvPremiums      PsvPremium[]

  @@index([coverage, agentcode, underwriterId], map: "Product_coverage_agentcode_underwriter_idx")
  @@index([underwriterName], map: "Product_underwriterName_idx")
}

model PsvPremium {
  id             Int       @id @default(autoincrement())
  productId      Int
  passengers     Int       // exact seat capacity
  premium_week   Float?
  premium_2weeks Float?
  premium_month  Float?
  premium_3months Float?
  premium_6months Float?
  premium_annual Float?

  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Quote {
  id                Int          @id @default(autoincrement())
  productId         Int
  userId            Int?
  createdAt         DateTime     @default(now())

  // Vehicle Information
  vehicleReg        String       @unique @db.VarChar(50)
  make              String?      @db.VarChar(100)
  model             String?      @db.VarChar(100)
  yearOfManufacture Int?         @db.SmallInt
  value             Decimal?     @db.Decimal(12,2)
  tonnage           Int?         @db.SmallInt
  passengers        Int?         @db.SmallInt

  // Insurance Details
  cover             CoverageType
  coverPeriod       CoverPeriod
  agentCode         String       @db.VarChar(50)
  price             Decimal      @db.Decimal(10,2)

  // Contact Details
  contactName       String       @db.VarChar(120)
  email             String       @db.VarChar(150)
  phoneNumber       String       @db.VarChar(30)

  // Relations
  policy            Policy?      @relation("QuoteToPolicy")
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([agentCode])
  @@index([cover])
  @@index([vehicleReg])
  @@index([createdAt])
}

model Policy {
  id        Int     @id @default(autoincrement())
  clientId  Int?
  productId Int
  quoteId   Int     @unique
  userId    Int
  claims    Claim[]
  Client    Client? @relation(fields: [clientId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  quote     Quote   @relation("QuoteToPolicy", fields: [quoteId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

model Client {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  phone    String
  address  String
  userId   Int
  claims   Claim[]
  user     User     @relation(fields: [userId], references: [id])
  policies Policy[]
}

model Claim {
  id        Int      @id @default(autoincrement())
  policyId  Int
  status    String
  amount    Float
  clientId  Int
  createdAt DateTime @default(now())
  reason    String
  client    Client   @relation(fields: [clientId], references: [id])
  policy    Policy   @relation(fields: [policyId], references: [id])
}

enum VehicleClass {
  MOTORCYCLE_PRIVATE
  MOTORCYCLE_PSV
  MOTORCYCLE_COMMERCIAL
  TRICYCLE_OWN_GOODS
  TRICYCLE_PSV
  MOTORVEHICLE_PRIVATE
  MOTORVEHICLE_OWN_GOODS
  MOTORVEHICLE_GENERAL_CARTAGE
  MOTORVEHICLE_AGRICULTURE
  MOTORVEHICLE_CHAUFFEUR
  MOTOR_TRADE
  MOTORVEHICLE_INSTITUTIONAL
  MOTORVEHICLE_DRIVING_SCHOOL
  MOTORVEHICLE_TOUR_SERVICE
  PSV_MATATU
  PSV_TAXI
  PSV_BUS
  AMBULANCE_FIRE
  HEAVY_MACHINERY
  UBER
  TANKER_LIQUID
  PRIME_MOVER
}

enum CoverageType {
  THIRD_PARTY_ONLY
  THIRD_PARTY_FIRE_AND_THEFT
  COMPREHENSIVE
}

enum CoverPeriod {
  ONE_WEEK
  TWO_WEEKS
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  ONE_YEAR
}
