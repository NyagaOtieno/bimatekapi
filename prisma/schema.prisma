generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String

  // Relations
  clients  Client[]
  policies Policy[]
  quotes   Quote[]
}
model Product {
  id                 Int      @id @default(autoincrement())
  name               String
  description        String
  basePremium        Float
  underwriter        String
  vehicleClass       String
  coverage           String
  period             String      // e.g., "1 year"
  value              Float       // e.g., 1500000
  make               String
  yearOfManufacture  Int
  tonnage            Int?
  passengers         Int?
  agentcode          String

  quotes             Quote[]
  policies           Policy[]

  @@unique([vehicleClass, coverage, make, yearOfManufacture, period, agentcode])
}


model Quote {
  id                Int      @id @default(autoincrement())
  productId         Int
  userId            Int?     // optional for anonymous quote
  price             Float
  value             Float
  period            Int
  make              String?  // optional
  yearOfManufacture Int?     // optional
  agent_code        Int

  name_contact      String
  email             String
  phone_number      String

  // ✅ Additional fields to support frontend journey
  vehicle_reg       String?  // e.g. KDA 123A
  cover             String   // e.g. "Comprehensive"
  coverperiod       String   // e.g. "1 year"
  tonnage           Int?     // optional
  passengers        Int?     // optional

  createdAt         DateTime @default(now())

  // Relations
  product           Product  @relation(fields: [productId], references: [id])
  user              User?    @relation(fields: [userId], references: [id])
  policy            Policy?  @relation("QuoteToPolicy", fields: [id], references: [quoteId])
}

model Policy {
  id        Int     @id @default(autoincrement())
  quoteId   Int
  productId Int
  userId    Int

  // Relations
  quote     Quote   @relation("QuoteToPolicy", fields: [quoteId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

model Client {
  id       Int      @id @default(autoincrement())
  name     String
  email    String
  phone    String
  address  String
  userId   Int

  // Relations
  claims   Claim[]
  user     User     @relation(fields: [userId], references: [id])
  policies Policy[]
}

model Claim {
  id        Int      @id @default(autoincrement())
  policyId  Int
  status    String
  amount    Int
  clientId  Int
  createdAt DateTime @default(now())
  reason    String

  // Relations
  client    Client   @relation(fields: [clientId], references: [id])
  policy    Policy   @relation(fields: [policyId], references: [id])
}
