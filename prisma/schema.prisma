generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  clients  Client[]
  policies Policy[]
  quotes   Quote[]
}

model Underwriter {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id             Int       @id @default(autoincrement())
  name           String
  description    String
  underwriterId  Int
  underwriter    Underwriter @relation(fields: [underwriterId], references: [id])
  agentcode      String
  basePremium    Float?          // Fixed premium for TPO products
  premium_annual Float?          // Only for Comprehensive (as rate)
  minimumPremium Float?          // Optional, only used if coverage = "Comprehensive"
  coverPeriod    String?         // Used for TPO to determine premium
  vehicleClass   VehicleClass[]
  coverage       CoverageType
  passengers     Int?            // Only for PSV TPO
  tonnage        Int?            // Only for Commercial TPO
  minAge         Int?            // Only for Comprehensive
  maxAge         Int?            // Only for Comprehensive
  minValue       Float?          // Only for Comprehensive
  maxValue       Float?          // Only for Comprehensive
  ExcludedMakes  String[]        // Only for Comprehensive
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  policies       Policy[]
  quotes         Quote[]

  @@index([vehicleClass, coverage, coverPeriod, agentcode, underwriterId], map: "Product_vehicleClass_coverage_coverPeriod_agentcode_underwr_idx")
}

model Quote {
  id                Int       @id @default(autoincrement())
  productId         Int
  userId            Int?
  price             Float
  createdAt         DateTime  @default(now())

  // Vehicle info
  make              String?
  value             Float?
  yearOfManufacture Int?
  vehicle_reg       String?

  // Insurance details
  agentcode         String
  cover             String   // e.g. "TPO", "Comprehensive"
  coverPeriod       String   // e.g. "1 year", "6 months"

  // Contact details
  email             String
  name_contact      String
  phone_number      String

  // Specific use-case fields
  passengers        Int?     // For PSV Matatu / Bus
  tonnage           Int?     // For Commercial / General Cartage

  // Relations
  policy            Policy?  @relation("QuoteToPolicy")
  product           Product  @relation(fields: [productId], references: [id])
  user              User?    @relation(fields: [userId], references: [id])
}

model Policy {
  id        Int     @id @default(autoincrement())
  clientId  Int?
  productId Int
  quoteId   Int     @unique
  userId    Int
  claims    Claim[]
  Client    Client? @relation(fields: [clientId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  quote     Quote   @relation("QuoteToPolicy", fields: [quoteId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

model Client {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  phone    String
  address  String
  userId   Int
  claims   Claim[]
  user     User     @relation(fields: [userId], references: [id])
  policies Policy[]
}

model Claim {
  id        Int      @id @default(autoincrement())
  policyId  Int
  status    String
  amount    Int
  clientId  Int
  createdAt DateTime @default(now())
  reason    String
  client    Client   @relation(fields: [clientId], references: [id])
  policy    Policy   @relation(fields: [policyId], references: [id])
}

enum VehicleClass {
  MOTORCYCLE_PRIVATE
  MOTORCYCLE_PSV
  MOTORCYCLE_COMMERCIAL
  TRICYCLE_OWN_GOODS
  TRICYCLE_PSV
  MOTORVEHICLE_PRIVATE
  MOTORVEHICLE_OWN_GOODS
  MOTORVEHICLE_GENERAL_CARTAGE
  MOTORVEHICLE_AGRICULTURE
  MOTORVEHICLE_CHAUFFEUR
  MOTOR_TRADE
  MOTORVEHICLE_INSTITUTIONAL
  MOTORVEHICLE_DRIVING_SCHOOL
  MOTORVEHICLE_TOUR_SERVICE
  PSV_MATATU
  PSV_TAXI
  PSV_BUS
  AMBULANCE_FIRE
  HEAVY_MACHINERY
  UBER
  TANKER_LIQUID
  PRIME_MOVER
}

enum CoverageType {
  THIRD_PARTY_ONLY
  THIRD_PARTY_FIRE_AND_THEFT
  COMPREHENSIVE
}
