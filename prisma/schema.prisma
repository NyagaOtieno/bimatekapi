generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleClassId {
  MOTORCYCLE_PRIVATE
  MOTORCYCLE_PSV
  MOTORCYCLE_COMMERCIAL
  TRICYCLE_OWN_GOODS
  TRICYCLE_PSV
  MOTORVEHICLE_PRIVATE
  MOTORVEHICLE_OWN_GOODS
  MOTORVEHICLE_GENERAL_CARTAGE
  MOTORVEHICLE_AGRICULTURE
  MOTORVEHICLE_CHAUFFEUR
  MOTOR_TRADE
  MOTORVEHICLE_INSTITUTIONAL
  MOTORVEHICLE_DRIVING_SCHOOL
  MOTORVEHICLE_TOUR_SERVICE
  PSV_MATATU
  PSV_TAXI
  PSV_BUS
  AMBULANCE_FIRE
  HEAVY_MACHINERY
  UBER
  TANKER_LIQUID
  PRIME_MOVER
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  clients  Client[]
  policies Policy[]
  quotes   Quote[]
}

model Product {
  id                Int            @id @default(autoincrement())
  name              String
  description       String
  basePremium       Float
  underwriter       String
  vehicleClass      VehicleClassId
  coverage          String
  period            String? // Optional for TPO
  ExcludedMakes     String? // Optional; only for Comprehensive
  passengers        Int?
  agentcode         String

  // ✅ Vehicle age restrictions
  minAge Int?
  maxAge Int?

  // ✅ Vehicle value restrictions
  minValue Float?
  maxValue Float?

  // ✅ TPO-specific premiums
  premium_week    Float?
  premium_2weeks  Float?
  premium_month   Float?
  premium_3months Float?
  premium_6months Float?
  premium_annual  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes   Quote[]
  policies Policy[]

  // ✅ Modified unique constraint (excluding make + yearOfManufacture)
  @@unique([vehicleClass, coverage, period, agentcode])
}

model Quote {
  id                Int     @id @default(autoincrement())
  productId         Int
  userId            Int?
  price             Float // Calculated and stored
  value             Float? // Optional for TPO
  period            String // e.g. "1 month"
  make              String? // Optional for TPO
  yearOfManufacture Int? // Optional for TPO
  agent_code        String

  name_contact String
  email        String
  phone_number String

  vehicle_reg String?
  cover       String // "TPO" or "Comprehensive"
  tonnage     Int?
  passengers  Int?

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
  policy  Policy? @relation("QuoteToPolicy")
}

model Policy {
  id        Int  @id @default(autoincrement())
  quoteId   Int  @unique
  productId Int
  userId    Int
  clientId  Int?

  quote   Quote   @relation("QuoteToPolicy", fields: [quoteId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  Client  Client? @relation(fields: [clientId], references: [id])
  claims  Claim[]
}

model Client {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  phone    String
  address  String
  userId   Int
  user     User     @relation(fields: [userId], references: [id])
  claims   Claim[]
  policies Policy[]
}

model Claim {
  id        Int      @id @default(autoincrement())
  policyId  Int
  status    String
  amount    Int
  clientId  Int
  createdAt DateTime @default(now())
  reason    String

  client Client @relation(fields: [clientId], references: [id])
  policy Policy @relation(fields: [policyId], references: [id])
}
