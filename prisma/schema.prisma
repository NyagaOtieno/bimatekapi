generator client { 
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  clients  Client[]
  policies Policy[]
  quotes   Quote[]
}

model Product {
  id              Int           @id @default(autoincrement())
  name            String
  basePremium     Float
  description     String
  underwriter     String
  agentcode       String
  createdAt       DateTime      @default(now())
  passengers      Int?
  coverPeriod     String?
  updatedAt       DateTime      @updatedAt
  maxAge          Int?
  maxValue        Float?
  minAge          Int?
  minValue        Float?
  premium_2weeks  Float?
  premium_3months Float?
  premium_6months Float?
  premium_annual  Float?
  premium_month   Float?
  premium_week    Float?
  ExcludedMakes   String[]      // Array of excluded vehicle makes
  coverage        CoverageType[] // ✅ Changed to array
  vehicleClass    String[]
  maxTonnage      Int?
  minTonnage      Int?
  tonnage         Int?
  policies        Policy[]
  quotes          Quote[]

  @@index([vehicleClass, coverage, coverPeriod, agentcode, underwriter])
}

model Quote {
  id                Int      @id @default(autoincrement())
  productId         Int
  userId            Int?
  price             Float
  createdAt         DateTime @default(now())
  coverPeriod       String
  value             Float?
  yearOfManufacture Int?
  agent_code        String
  cover             String
  email             String
  name_contact      String
  passengers        Int?
  phone_number      String
  tonnage           Int?
  vehicle_reg       String?
  make              String?
  policy            Policy?  @relation("QuoteToPolicy")
  product           Product  @relation(fields: [productId], references: [id])
  user              User?    @relation(fields: [userId], references: [id])
}

model Policy {
  id        Int     @id @default(autoincrement())
  clientId  Int?
  productId Int
  quoteId   Int     @unique
  userId    Int
  claims    Claim[]
  Client    Client? @relation(fields: [clientId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  quote     Quote   @relation("QuoteToPolicy", fields: [quoteId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

model Client {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  phone    String
  address  String
  userId   Int
  claims   Claim[]
  user     User     @relation(fields: [userId], references: [id])
  policies Policy[]
}

model Claim {
  id        Int      @id @default(autoincrement())
  policyId  Int
  status    String
  amount    Int
  clientId  Int
  createdAt DateTime @default(now())
  reason    String
  client    Client   @relation(fields: [clientId], references: [id])
  policy    Policy   @relation(fields: [policyId], references: [id])
}

enum VehicleClass {
  MOTORCYCLE_PRIVATE
  MOTORCYCLE_PSV
  MOTORCYCLE_COMMERCIAL
  TRICYCLE_OWN_GOODS
  TRICYCLE_PSV
  MOTORVEHICLE_PRIVATE
  MOTORVEHICLE_OWN_GOODS
  MOTORVEHICLE_GENERAL_CARTAGE
  MOTORVEHICLE_AGRICULTURE
  MOTORVEHICLE_CHAUFFEUR
  MOTOR_TRADE
  MOTORVEHICLE_INSTITUTIONAL
  MOTORVEHICLE_DRIVING_SCHOOL
  MOTORVEHICLE_TOUR_SERVICE
  PSV_MATATU
  PSV_TAXI
  PSV_BUS
  AMBULANCE_FIRE
  HEAVY_MACHINERY
  UBER
  TANKER_LIQUID
  PRIME_MOVER
}

enum CoverageType {
  THIRD_PARTY_ONLY
  THIRD_PARTY_FIRE_AND_THEFT
  COMPREHENSIVE
}
