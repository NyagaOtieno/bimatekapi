{
  "name": "bimatekapi",
  "version": "1.0.0",
  "description": "Bimatek API backend using Prisma and Sequelize",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node prisma/seed.js",
    "push": "prisma db push && prisma generate",
    "migrate": "npx sequelize-cli db:migrate --config=config/config.js",
    "migrate:generate": "npx sequelize-cli migration:generate --name",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@prisma/client": "^6.14.0",
    "nodemon": "^3.1.0",
    "prisma": "^6.14.0",
    "sequelize-cli": "^6.6.1"
  }
}
